<!-- Snap-to-toggle dark mode via microphone -->
<!-- Uses frequency analysis to distinguish finger snaps from voice/music -->

<div
  id="snap-toast"
  aria-live="polite"
  class="fixed bottom-6 left-1/2 z-[200] flex items-center gap-3 px-5 py-3 rounded-2xl shadow-xl text-sm font-semibold pointer-events-none select-none"
  style="opacity: 0; transform: translate(-50%, 1rem); transition: opacity 0.35s ease, transform 0.35s ease;"
>
  <span id="snap-toast-icon" class="text-lg">🌙</span>
  <span id="snap-toast-text">Dark mode on</span>
</div>

<script>
  (async () => {
    // ── Tuning ─────────────────────────────────────────────────────────────
    // A finger snap is a very short, broadband transient with strong
    // high-frequency energy. Voice and music are sustained and low-frequency.

    const SAMPLE_RATE         = 44100;
    const FFT_SIZE            = 1024;

    // RMS threshold — snap must be loud enough
    const RMS_THRESHOLD       = 0.08;

    // High-freq ratio: snaps have lots of energy above ~2 kHz relative to total.
    // Voice sits mostly below 1 kHz. Require at least this ratio in high bins.
    const HIGH_FREQ_RATIO     = 0.40;

    // How many consecutive loud frames before we consider it "sustained" (not a snap)
    const MAX_LOUD_FRAMES     = 6;   // ~6 × 16ms ≈ 100ms at 60fps

    // Cooldown between snaps
    const COOLDOWN_MS         = 900;

    // ── Toast ──────────────────────────────────────────────────────────────
    const toast     = document.getElementById("snap-toast")!;
    const toastIcon = document.getElementById("snap-toast-icon")!;
    const toastText = document.getElementById("snap-toast-text")!;
    let toastTimer: ReturnType<typeof setTimeout> | null = null;

    function showToast(dark: boolean) {
      toastIcon.textContent = dark ? "🌙" : "☀️";
      toastText.textContent = dark ? "Dark mode on" : "Light mode on";
      toast.classList.remove("bg-slate-900", "text-white", "bg-white", "text-slate-800");
      toast.classList.add(
        ...(dark
          ? ["bg-slate-900", "text-white"]
          : ["bg-white", "text-slate-800"])
      );
      toast.style.opacity = "1";
      toast.style.transform = "translate(-50%, 0)";
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.style.opacity = "0";
        toast.style.transform = "translate(-50%, 1rem)";
      }, 2200);
    }

    // ── Dark mode toggle ───────────────────────────────────────────────────
    function toggleDark() {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      showToast(isDark);
      document.dispatchEvent(new CustomEvent("theme-changed", { detail: { dark: isDark } }));
    }

    // ── Mic access ────────────────────────────────────────────────────────
    let stream: MediaStream;
    try {
      stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
    } catch {
      console.warn("[SnapDarkMode] Microphone permission denied.");
      return;
    }

    const ctx      = new AudioContext();
    const source   = ctx.createMediaStreamSource(stream);

    // Time-domain analyser for RMS
    const timeDom  = ctx.createAnalyser();
    timeDom.fftSize = FFT_SIZE;
    source.connect(timeDom);

    // Frequency analyser for spectral check
    const freqDom  = ctx.createAnalyser();
    freqDom.fftSize = FFT_SIZE;
    source.connect(freqDom);

    const timeBuf  = new Float32Array(timeDom.fftSize);
    const freqBuf  = new Uint8Array(freqDom.frequencyBinCount);  // 0–255 per bin

    // Bin index corresponding to ~2 kHz
    const highFreqStartBin = Math.floor(2000 / (SAMPLE_RATE / FFT_SIZE));

    function getRMS(): number {
      timeDom.getFloatTimeDomainData(timeBuf);
      let s = 0;
      for (let i = 0; i < timeBuf.length; i++) s += timeBuf[i] * timeBuf[i];
      return Math.sqrt(s / timeBuf.length);
    }

    function getHighFreqRatio(): number {
      freqDom.getByteFrequencyData(freqBuf);
      let total = 0, high = 0;
      for (let i = 0; i < freqBuf.length; i++) {
        total += freqBuf[i];
        if (i >= highFreqStartBin) high += freqBuf[i];
      }
      return total === 0 ? 0 : high / total;
    }

    // ── Detection state machine ────────────────────────────────────────────
    // States: IDLE → ATTACK (first loud frame) → check on falling edge
    // If loud for too many frames → SUSTAINED (voice/music) → back to IDLE

    let state: "idle" | "attack" | "sustained" = "idle";
    let loudFrames  = 0;
    let lastSnap    = 0;

    function loop() {
      requestAnimationFrame(loop);

      const now  = performance.now();
      const rms  = getRMS();
      const loud = rms > RMS_THRESHOLD;

      if (state === "idle") {
        if (loud) {
          state      = "attack";
          loudFrames = 1;
        }

      } else if (state === "attack") {
        if (loud) {
          loudFrames++;
          if (loudFrames > MAX_LOUD_FRAMES) {
            // Too long — this is voice, music, clap, etc.
            state = "sustained";
          }
        } else {
          // Falling edge — short burst, now check frequency profile
          const ratio = getHighFreqRatio();
          const sinceSnap = now - lastSnap;

          if (ratio >= HIGH_FREQ_RATIO && sinceSnap > COOLDOWN_MS) {
            // ✅ Short burst + high-frequency rich = finger snap
            lastSnap = now;
            toggleDark();
          }
          state      = "idle";
          loudFrames = 0;
        }

      } else if (state === "sustained") {
        // Wait for silence before resetting
        if (!loud) {
          state      = "idle";
          loudFrames = 0;
        }
      }
    }

    loop();
  })();
</script>
