---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{hasProjects && (
  <section id="projects" class="py-24 px-8 sm:px-12 md:px-24 bg-slate-50 dark:bg-[#0a0f1e]">
    <div class="max-w-7xl mx-auto">

      <!-- Section header -->
      <div class="mb-16">
        <p class="text-sm font-semibold tracking-widest uppercase mb-3" style={`color: ${siteConfig.accentColor}`}>
          What I've built
        </p>
        <h2 class="text-4xl sm:text-5xl xl:text-6xl font-bold text-slate-900 dark:text-white leading-tight">
          Projects
        </h2>
        <div class="w-16 h-1 mt-4 rounded-full" style={`background: ${siteConfig.accentColor}`}></div>
      </div>

      <!-- Projects grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {siteConfig.projects.map((project, index) => {
          const Component = project.link ? "a" : "div";
          const linkProps = project.link
            ? { href: project.link, target: "_blank", rel: "noopener noreferrer" }
            : {};

          return (
            <div class="group">
              <Component
                {...linkProps}
                class="flex flex-col h-full p-6 sm:p-8 rounded-2xl border transition-all duration-300 bg-white dark:bg-slate-900/80 border-slate-200 dark:border-slate-800 hover:border-[var(--accent-color)] hover:shadow-xl hover:-translate-y-1"
                style={`--accent-color: ${siteConfig.accentColor}`}
              >
                <!-- Number + arrow -->
                <div class="flex items-center justify-between mb-5">
                  <span
                    class="text-xs font-bold tracking-widest uppercase px-3 py-1 rounded-full"
                    style={`color: ${siteConfig.accentColor}; background: ${siteConfig.accentColor}15`}
                  >
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  {project.link && (
                    <div
                      class="w-9 h-9 flex items-center justify-center rounded-full border border-slate-200 dark:border-slate-700 text-slate-400 group-hover:text-[var(--accent-color)] group-hover:border-[var(--accent-color)] transition-all duration-300"
                      style={`--accent-color: ${siteConfig.accentColor}`}
                    >
                      <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17"/>
                      </svg>
                    </div>
                  )}
                </div>

                <!-- Title -->
                <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3 group-hover:text-[var(--accent-color)] transition-colors duration-300"
                    style={`--accent-color: ${siteConfig.accentColor}`}>
                  {project.name}
                </h3>

                <!-- Description -->
                <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 leading-relaxed flex-1 mb-5">
                  {project.description}
                </p>

                <!-- Skills -->
                {project.skills && project.skills.length > 0 && (
                  <div class="flex flex-wrap gap-2 mt-auto">
                    {project.skills.map((skill) => (
                      <span class="px-2.5 py-1 text-xs font-semibold rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
                        {skill}
                      </span>
                    ))}
                  </div>
                )}
              </Component>
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}
