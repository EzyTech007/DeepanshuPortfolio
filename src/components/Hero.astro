---
import { siteConfig } from "../config";
---

<div
  id="hero"
  class="relative isolate overflow-hidden min-h-screen flex flex-col justify-center"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <!-- Full background: dark in dark mode, soft light in light mode -->
  <div class="absolute inset-0 -z-20 bg-slate-50 dark:bg-[#0a0f1e]"></div>

  <!-- Subtle radial glow centered -->
  <div
    class="absolute inset-0 -z-10 pointer-events-none"
    style={`background: radial-gradient(ellipse 70% 60% at 50% 40%, ${siteConfig.accentColor}18 0%, transparent 70%)`}
  ></div>

  <!-- Dot grid pattern -->
  <div
    class="absolute inset-0 -z-10 pointer-events-none opacity-30 dark:opacity-20"
    style={`background-image: radial-gradient(circle, ${siteConfig.accentColor}55 1px, transparent 1px); background-size: 32px 32px;`}
  ></div>

  <!-- Top-left accent blob -->
  <div
    class="absolute -top-32 -left-32 w-96 h-96 rounded-full blur-3xl opacity-20 dark:opacity-15 -z-10"
    style={`background: ${siteConfig.accentColor}`}
  ></div>

  <!-- Bottom-right accent blob -->
  <div
    class="absolute -bottom-32 -right-32 w-80 h-80 rounded-full blur-3xl opacity-10 dark:opacity-10 -z-10"
    style={`background: ${siteConfig.accentColor}`}
  ></div>

  <!-- Main content -->
  <div class="flex-1 flex items-center mx-auto w-full max-w-7xl px-8 sm:px-12 md:px-24 py-32">
    <div class="max-w-4xl">

      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-blue-200 dark:border-blue-900 bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-300 text-sm font-medium mb-8 animate-fade-in">
        <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
        Available for opportunities
      </div>

      <p class="text-lg sm:text-xl md:text-2xl font-medium text-slate-500 dark:text-slate-400 mb-4 animate-fade-in animation-delay-100">
        Hello! 👋 I'm
      </p>

      <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight text-slate-900 dark:text-white mb-6 animate-fade-in animation-delay-200 leading-[1.05]">
        {siteConfig.name}
      </h1>

      <!-- Animated role line -->
      <div class="flex items-center gap-3 mb-8 animate-fade-in animation-delay-300">
        <div class="w-10 h-0.5 rounded-full" style={`background: ${siteConfig.accentColor}`}></div>
        <p class="text-xl sm:text-2xl md:text-3xl font-semibold" style={`color: ${siteConfig.accentColor}`}>
          {siteConfig.title}
        </p>
      </div>

      <!-- Short tagline -->
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-xl leading-relaxed mb-10 animate-fade-in animation-delay-400">
        Building scalable web applications with modern technologies. Passionate about clean code, system design, and impactful digital solutions.
      </p>

      <!-- CTA buttons -->
      <div class="flex flex-wrap gap-4 mb-12 animate-fade-in animation-delay-500">
        <a
          href="#projects"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-white shadow-lg transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl"
          style={`background: ${siteConfig.accentColor}; box-shadow: 0 4px 24px ${siteConfig.accentColor}40`}
        >
          View Projects
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a
          href={`mailto:${siteConfig.social.email}`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md"
        >
          Contact Me
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </a>
      </div>

      <!-- Social icons -->
      <div class="flex gap-4 animate-fade-in animation-delay-600">
        {siteConfig.social?.linkedin && (
          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="w-10 h-10 flex items-center justify-center rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-[var(--accent-color)] hover:border-[var(--accent-color)] transition-all duration-300 hover:-translate-y-0.5 shadow-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M8 11v5"/><path d="M8 8v.01"/><path d="M12 16v-5"/>
              <path d="M16 16v-3a2 2 0 1 0 -4 0"/>
              <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z"/>
            </svg>
          </a>
        )}
        {siteConfig.social?.github && (
          <a
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="w-10 h-10 flex items-center justify-center rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-[var(--accent-color)] hover:border-[var(--accent-color)] transition-all duration-300 hover:-translate-y-0.5 shadow-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"/>
            </svg>
          </a>
        )}
        {siteConfig.social?.twitter && (
          <a
            href={siteConfig.social.twitter}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="X / Twitter"
            class="w-10 h-10 flex items-center justify-center rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-[var(--accent-color)] hover:border-[var(--accent-color)] transition-all duration-300 hover:-translate-y-0.5 shadow-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M4 4l11.733 16h4.267l-11.733 -16z"/>
              <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/>
            </svg>
          </a>
        )}
        {siteConfig.social?.email && (
          <a
            href={`mailto:${siteConfig.social.email}`}
            aria-label="Email"
            class="w-10 h-10 flex items-center justify-center rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-[var(--accent-color)] hover:border-[var(--accent-color)] transition-all duration-300 hover:-translate-y-0.5 shadow-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"/>
              <path d="M3 7l9 6l9 -6"/>
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="flex justify-center pb-10 animate-fade-in animation-delay-700">
    <a href="#about" aria-label="Scroll down" class="flex flex-col items-center gap-2 text-slate-400 dark:text-slate-600 hover:text-[var(--accent-color)] transition-colors duration-300 group">
      <span class="text-xs font-medium tracking-widest uppercase">Scroll</span>
      <div class="w-5 h-8 rounded-full border-2 border-current flex items-start justify-center p-1">
        <div class="w-1 h-2 rounded-full bg-current animate-scroll-dot"></div>
      </div>
    </a>
  </div>
</div>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes scrollDot {
    0%   { transform: translateY(0); opacity: 1; }
    80%  { transform: translateY(10px); opacity: 0; }
    100% { transform: translateY(0); opacity: 0; }
  }

  .animate-fade-in {
    animation: fadeIn 0.7s ease-out forwards;
    opacity: 0;
  }
  .animation-delay-100  { animation-delay: 0.1s; }
  .animation-delay-200  { animation-delay: 0.2s; }
  .animation-delay-300  { animation-delay: 0.3s; }
  .animation-delay-400  { animation-delay: 0.4s; }
  .animation-delay-500  { animation-delay: 0.5s; }
  .animation-delay-600  { animation-delay: 0.6s; }
  .animation-delay-700  { animation-delay: 0.8s; }

  .animate-scroll-dot {
    animation: scrollDot 1.8s ease-in-out infinite;
  }
</style>
